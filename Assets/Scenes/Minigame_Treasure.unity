  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroductionManager
  introPanel: {fileID: 8243340791660669444}
  introText: {fileID: 412828530710553969}
  loomakImage: {fileID: 2423961123319466623}
  fillContainer: {fileID: 4884309852083156223}
  frameContainer: {fileID: 4729375586018956411}
  nextButton: {fileID: 1473540584201133409}
  slides:
  - message: "\u0628\u0647 \u062C\u0632\u06CC\u0631\u0647 \u06AF\u0646\u062C \u062E\u0648\u0634
      \u0627\u0648\u0645\u062F\u06CC!"
    loomakSprite: {fileID: -1440929055495075452, guid: b752dae3af200944283ff7de1febe1dc, type: 3}
  - message: "\u0627\u06CC\u0646\u062C\u0627 \u0627\u0644\u0645\u0627\u0633 \u0622\u062E\u0631
      \u06A9\u0644\u06CC\u062F \u067E\u0627\u0646\u062F\u0648\u0631\u0627 \u067E\u0646\u0647\u0648\u0646
      \u0634\u062F\u0647. \u0627\u0645\u0627 \u063A\u0645\u060C \u0627\u0648\u0646
      \u062F\u0634\u0645\u0646 \u0633\u0648\u0645\u060C \u0627\u0648\u0645\u062F\u0647
      \u0648 \u0627\u06CC\u0646 \u062C\u0632\u06CC\u0631\u0647 \u0631\u0648 \u067E\u0631
      \u0627\u0632 \u062A\u0644\u0647 \u06A9\u0631\u062F\u0647."
    loomakSprite: {fileID: 8644409666869483812, guid: 54d8007ce5db81440ab9fd6f4061d5d9, type: 3}
  - message: "\u0627\u0644\u0645\u0627\u0633 \u062A\u0648\u06CC \u06CC\u06A9\u06CC
      \u0627\u0632 \u0627\u06CC\u0646 \u0635\u0646\u062F\u0648\u0642\u200C\u0647\u0627\u0633\u062A.
      \u0628\u0627\u06CC\u062F \u0647\u0648\u0634\u0645\u0646\u062F\u0627\u0646\u0647
      \u0628\u06AF\u0631\u062F\u06CC\u0645\u060C \u0647\u0631 \u0635\u0646\u062F\u0648\u0642\u06CC
      \u06A9\u0647 \u0628\u0627\u0632 \u06A9\u0631\u062F\u06CC\u0645 \u0648 \u062E\u0627\u0644\u06CC
      \u0628\u0648\u062F\u060C \u0646\u0628\u0627\u06CC\u062F \u062F\u0648\u0628\u0627\u0631\u0647
      \u0628\u06AF\u0631\u062F\u06CC\u0645\u0634. \u0628\u0627\u06CC\u062F \u06CC\u0627\u062F\u0645\u0648\u0646
      \u0628\u0627\u0634\u0647 \u06A9\u062C\u0627 \u0631\u0641\u062A\u06CC\u0645!"
    loomakSprite: {fileID: -1440929055495075452, guid: b752dae3af200944283ff7de1febe1dc, type: 3}
  - message: "\u0627\u0644\u0645\u0627\u0633 \u062A\u0648\u06CC \u06CC\u06A9\u06CC
      \u0627\u0632 \u0627\u06CC\u0646 \u0635\u0646\u062F\u0648\u0642\u200C\u0647\u0627\u0633\u062A.
      \u0628\u0627\u0632 \u06A9\u0646 \u0648 \u0628\u0628\u06CC\u0646\u060C \u0627\u06AF\u0647
      \u0646\u0628\u0648\u062F\u060C \u06CC\u0627\u062F\u062A \u0628\u0627\u0634\u0647
      \u06A9\u0647 \u0627\u0648\u0646 \u0635\u0646\u062F\u0648\u0642 \u0631\u0648
      \u0627\u0645\u062A\u062D\u0627\u0646 \u06A9\u0631\u062F\u06CC. \u0628\u0631\u0648
      \u0633\u0631\u0627\u063A \u0628\u0639\u062F\u06CC!"
    loomakSprite: {fileID: 2081541123441031124, guid: 8223f6aefb6f50845814771cbc81146c, type: 3}
