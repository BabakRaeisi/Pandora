  m_Script: {fileID: 11500000, guid: dfc35f5539fd6a1409838bc3c7060d59, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroductionManager
  introPanel: {fileID: 0}
  introText: {fileID: 1394682914}
  loomakImage: {fileID: 1394682913}
  fillContainer: {fileID: 1394682912}
  frameContainer: {fileID: 1394682910}
  nextButton: {fileID: 1394682911}
  slides:
  - message: "\u0627\u0645\u06CC\u062F \u0622\u0632\u0627\u062F \u0634\u062F! \u062F\u0646\u06CC\u0627
      \u062F\u0648\u0628\u0627\u0631\u0647 \u0631\u0646\u06AF \u06AF\u0631\u0641\u062A!
      \u0633\u062A\u0627\u0631\u0647\u0627 \u0628\u0631\u06AF\u0634\u062A\u0646\u060C
      \u067E\u0644\u0647\u0627 \u0645\u062D\u06A9\u0645\u0646\u060C \u06AF\u0646\u062C\u0647\u0627
      \u067E\u06CC\u062F\u0627 \u0634\u062F\u0646. \u0647\u0645\u0647 \u0686\u06CC\u0632
      \u0627\u0632 \u0646\u0648 \u0634\u0631\u0648\u0639 \u0634\u062F!"
    loomakSprite: {fileID: -1440929055495075452, guid: b752dae3af200944283ff7de1febe1dc, type: 3}
  - message: "\u0645\u0645\u0646\u0648\u0646\u0645 \u06A9\u0647 \u0627\u0648\u0645\u062F\u06CC.
      \u0645\u0645\u0646\u0648\u0646\u0645 \u06A9\u0647 \u062A\u0644\u0627\u0634
      \u06A9\u0631\u062F\u06CC. \u0645\u0645\u0646\u0648\u0646\u0645 \u06A9\u0647
      \u062A\u0633\u0644\u06CC\u0645 \u0646\u0634\u062F\u06CC. \u0645\u06CC\u062E\u0648\u0627\u0645
      \u06CC\u0647 \u0686\u06CC\u0632\u06CC \u0628\u0647\u062A \u0628\u06AF\u0645
      \u06A9\u0647 \u0642\u0644\u0628\u0627\u064B \u0628\u0647\u0634 \u0627\u0639\u062A\u0642\u0627\u062F
      \u062F\u0627\u0631\u0645:"
    loomakSprite: {fileID: 4551388475707488161, guid: f0352b31fde69b748bcfab9f77cb0b07, type: 3}
  - message: "\xAB\u0630\u0647\u0646 \u0645\u062B\u0644 \u06CC\u0647 \u0628\u0627\u063A\u0647.
      \u0647\u0631 \u0631\u0648\u0632 \u06A9\u0647 \u0628\u0647\u0634 \u062A\u0648\u062C\u0647
      \u06A9\u0646\u06CC\u060C \u0634\u06A9\u0648\u0641\u0627\u062A\u0631 \u0645\u06CC\u0634\u0647.
      \u062A\u0648 \u0627\u0645\u0631\u0648\u0632 \u0628\u0627\u063A\u0628\u0648\u0646
      \u0630\u0647\u0646\u062A \u0628\u0648\u062F\u06CC.\xBB"
    loomakSprite: {fileID: -1440929055495075452, guid: b752dae3af200944283ff7de1febe1dc, type: 3}
  - message: "\u0627\u06CC\u0646 \u0628\u0627\u0632\u06CC \u062A\u0645\u0648\u0645
      \u0634\u062F \u0627\u0645\u0627 \u0633\u0641\u0631 \u062A\u0648 \u062A\u0627\u0632\u0647
      \u0634\u0631\u0648\u0639 \u0634\u062F\u0647. \u0647\u0631 \u0631\u0648\u0632
      \u06A9\u0647 \u062A\u0645\u0631\u06CC\u0646 \u06A9\u0646\u06CC\u060C \u0627\u0645\u06CC\u062F
      \u0628\u06CC\u0634\u062A\u0631\u06CC \u0628\u0647 \u062F\u0646\u06CC\u0627
      \u0628\u0631\u0645\u06CC\u06AF\u0631\u062F\u0647.\L\u0645\u0646\u062A\u0638\u0631\u062A\u0645!"
    loomakSprite: {fileID: 4551388475707488161, guid: f0352b31fde69b748bcfab9f77cb0b07, type: 3}
