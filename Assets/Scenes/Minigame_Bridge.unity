  m_Script: {fileID: 11500000, guid: dfc35f5539fd6a1409838bc3c7060d59, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroductionManager
  introPanel: {fileID: 3749976490648602446}
  introText: {fileID: 8513014153992705582}
  loomakImage: {fileID: 5925971664414046496}
  fillContainer: {fileID: 3483087870403987360}
  frameContainer: {fileID: 3620043154250344228}
  nextButton: {fileID: 7488911422522633790}
  slides:
  - message: "\u0628\u0647 \u062C\u0632\u06CC\u0631\u0647 \u0633\u0646\u06AF\u06CC
      \u062E\u0648\u0634 \u0627\u0648\u0645\u062F\u06CC!"
    loomakSprite: {fileID: 4551388475707488161, guid: f0352b31fde69b748bcfab9f77cb0b07, type: 3}
  - message: "\u0627\u06CC\u0646\u062C\u0627 \u06CC\u0647 \u0631\u0648\u0632\u06CC
      \u0627\u0633\u062A\u0627\u062F\u06A9\u0627\u0631\u0627\u0646 \u0645\u0627\u0647\u0631
      \u0628\u0627 \u0633\u0646\u06AF\u060C \u067E\u0644 \u0645\u06CC\u200C\u0633\u0627\u062E\u062A\u0646.
      \u0627\u0645\u0627 \u0641\u0631\u0627\u0645\u0648\u0634\u06CC\u200C\u0627\u06CC
      \u06A9\u0647 \u0627\u06CC\u0646\u062C\u0627 \u067E\u0631\u0627\u06A9\u0646\u062F\u0647
      \u0634\u062F\u0647\u060C \u062A\u0631\u062A\u06CC\u0628 \u0633\u0646\u06AF\u200C\u0647\u0627
      \u0631\u0648 \u0627\u0632 \u0628\u06CC\u0646 \u0628\u0631\u062F\u0647."
    loomakSprite: {fileID: 8644409666869483812, guid: 54d8007ce5db81440ab9fd6f4061d5d9, type: 3}
  - message: "\u0628\u0628\u06CC\u0646\u060C \u0627\u06CC\u0646 \u0633\u0646\u06AF\u200C\u0647\u0627
      \u0628\u0627\u06CC\u062F \u0628\u0647 \u062A\u0631\u062A\u06CC\u0628 \u06A9\u0646\u0627\u0631
      \u0647\u0645 \u0642\u0631\u0627\u0631 \u0628\u06AF\u06CC\u0631\u0646 \u062A\u0627
      \u067E\u0644 \u0634\u06A9\u0644 \u0628\u06AF\u06CC\u0631\u0647. \u0646\u0634\u0648\u0646\u062A
      \u0645\u06CC\u062F\u0645 \u06A9\u062F\u0648\u0645 \u0627\u0648\u0644\u060C
      \u06A9\u062F\u0648\u0645 \u062F\u0648\u0645 \u0628\u0639\u062F \u0646\u0648\u0628\u062A
      \u062A\u0648\u0626\u0647!"
    loomakSprite: {fileID: 8917812225305235770, guid: 5286be7969f225744acb969d882e1c23, type: 3}
  - message: "\u0628\u0628\u06CC\u0646\u060C \u0627\u06CC\u0646 \u0633\u0646\u06AF\u200C\u0647\u0627
      \u0628\u0627\u06CC\u062F \u0628\u0647 \u062A\u0631\u062A\u06CC\u0628 \u06A9\u0646\u0627\u0631
      \u0647\u0645 \u0642\u0631\u0627\u0631 \u0628\u06AF\u06CC\u0631\u0646 \u062A\u0627
      \u067E\u0644 \u0634\u06A9\u0644 \u0628\u06AF\u06CC\u0631\u0647. \u0646\u0634\u0648\u0646\u062A
      \u0645\u06CC\u062F\u0645 \u06A9\u062F\u0648\u0645 \u0627\u0648\u0644\u060C
      \u06A9\u062F\u0648\u0645 \u062F\u0648\u0645 \u0628\u0639\u062F \u0646\u0648\u0628\u062A
      \u062A\u0648\u0626\u0647!"
    loomakSprite: {fileID: 4551388475707488161, guid: f0352b31fde69b748bcfab9f77cb0b07, type: 3}
  - message: "\u0647\u0631 \u0628\u0627\u0631 \u06A9\u0647 \u062F\u0631\u0633\u062A
      \u0628\u0627\u0634\u0647\u060C \u06CC\u0647 \u0642\u0637\u0639\u0647 \u0627\u0632
      \u067E\u0644 \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0647.
      \u0648\u0642\u062A\u06CC \u0647\u0645\u0647 \u0642\u0637\u0639\u0647\u200C\u0647\u0627
      \u0622\u0645\u0627\u062F\u0647 \u0628\u0627\u0634\u0646\u060C \u067E\u0644
      \u06A9\u0627\u0645\u0644 \u0645\u06CC\u200C\u0634\u0647 \u0648 \u0645\u06CC\u200C\u062A\u0648\u0646\u06CC\u0645
      \u0631\u062F \u0628\u0634\u06CC\u0645!"
    loomakSprite: {fileID: -1440929055495075452, guid: b752dae3af200944283ff7de1febe1dc, type: 3}
